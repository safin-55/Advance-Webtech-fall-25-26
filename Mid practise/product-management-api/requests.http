@baseUrl = http://localhost:3000

### API status
GET {{baseUrl}}/

### Create first product - keep this response for the generated ID
# @name createProduct
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Notebook",
  "category": "Stationery",
  "price": 120.5,
  "quantity": 50
}

### Create a second product
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Blue Pen",
  "category": "Stationery",
  "price": 15,
  "quantity": 100
}

### Get all products
GET {{baseUrl}}/products

### Get the actual product created above
GET {{baseUrl}}/products/{{createProduct.response.body.$.id}}

### Update the product
PATCH {{baseUrl}}/products/{{createProduct.response.body.$.id}}
Content-Type: application/json

{
  "price": 135.75,
  "quantity": 40
}

### Confirm the update
GET {{baseUrl}}/products/{{createProduct.response.body.$.id}}

### Delete the product
DELETE {{baseUrl}}/products/{{createProduct.response.body.$.id}}

### Confirm deletion
GET {{baseUrl}}/products

### Create an employee (change email if you rerun manually)
# @name createEmployee
POST {{baseUrl}}/employees
Content-Type: application/json

{
  "name": "Amina Rahman",
  "email": "amina@example.com",
  "phone": "+8801712345678",
  "password": "Demo1234!",
  "age": 25,
  "yearsOfWorking": 3
}

### Get all employees
GET {{baseUrl}}/employees

### Get the employee created above
GET {{baseUrl}}/employees/{{createEmployee.response.body.$.id}}

### Update an employee
PATCH {{baseUrl}}/employees/{{createEmployee.response.body.$.id}}
Content-Type: application/json

{
  "phone": "+8801812345678",
  "yearsOfWorking": 4
}

### Confirm the update
GET {{baseUrl}}/employees/{{createEmployee.response.body.$.id}}

### Delete an employee
DELETE {{baseUrl}}/employees/{{createEmployee.response.body.$.id}}

### Confirm deletion
GET {{baseUrl}}/employees

### Expected 404 for a missing product
GET {{baseUrl}}/products/2147483647

### Expected 400 for invalid input
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Invalid product",
  "category": "Stationery",
  "price": -10,
  "quantity": 1.5
}
