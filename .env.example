# Local lab configuration. No database server or password is required for SQLite.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DB_TYPE=sqlite
DB_DATABASE=./data/shop.sqlite
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Only used when DB_TYPE=postgres or DB_TYPE=mysql.
# PostgreSQL defaults: DB_PORT=5432, DB_USERNAME=postgres
# MySQL defaults: DB_PORT=3306, DB_USERNAME=root
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=shop_lab
